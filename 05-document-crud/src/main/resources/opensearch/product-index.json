{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s",
    "index.mapping.coerce": false
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "_class": {"type": "keyword", "index": false, "doc_values": false},
      "name": {"type": "text", "fields": {"raw": {"type": "keyword", "ignore_above": 256}}},
      "category": {"type": "keyword"},
      "priceSatang": {"type": "long"},
      "stock": {"type": "integer"},
      "available": {"type": "boolean"},
      "createdAt": {"type": "date", "format": "date_optional_time"}
    }
  }
}
